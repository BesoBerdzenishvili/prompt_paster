{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Paster",
  "version": "0.1.1",
  "identifier": "app.promptpaster.desktop",
  "build": {
    "beforeDevCommand": "node scripts/dev-server.mjs",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "Prompt Paster",
        "url": "index.html",
        "width": 360,
        "height": 640,
        "minWidth": 300,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "vars",
        "title": "Fill variables",
        "url": "vars.html",
        "width": 340,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Paste saved prompts anywhere with a hotkey",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
